{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [
      "@webgpu/types"
    ]
  },
  "include": [
    "tests/types/**/*.ts",
    "tests/fixtures/geo-webmercator-addressing.ts"
  ]
}
